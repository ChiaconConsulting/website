# PostgreSQL connection string (Neon, Supabase, Azure, RDS or the bundled Docker database)
DATABASE_URL="postgresql://chiacon:chiacon@localhost:5432/chiacon"

# Public site URL, used for canonical links, sitemap and social cards
NEXT_PUBLIC_SITE_URL="https://www.chiacon.com"

# Long random string used to sign admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account, created by `npm run db:seed`. Change the password after first login.
ADMIN_EMAIL="admin@chiacon.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Chiacon Admin"

# Optional: email notification for new leads and job applications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Chiacon Website <no-reply@chiacon.com>"
LEADS_NOTIFY_TO="contactus@chiacon.com"
CAREERS_NOTIFY_TO="TeamHP@chiacon.com"

# Optional: Google Tag Manager container ID (the current site uses GTM-M9RLNWQG)
NEXT_PUBLIC_GTM_ID=""

# Only for docker-compose.yml (self-hosted database password)
POSTGRES_PASSWORD=""
